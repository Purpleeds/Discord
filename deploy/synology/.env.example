# Copy this file to ".env" (same folder) and fill it in. Never commit .env.

# The Postgres you already run on the NAS. Use a password made of letters
# and numbers only (other characters would break the connection address).
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
# The app reaches it through the NAS itself, on the port your Postgres
# compose file publishes ("55432:5432").
DB_HOST=host.docker.internal
DB_PORT=55432
# The chat gets its own database inside that Postgres (copy-from-neon.sh
# creates it), so it never touches main_database.
DB_NAME=chat

# Port on the NAS where the app answers (http://<nas-ip>:8080 at home).
APP_PORT=8080

# Files up to KEEP_FILE_MB are kept for good, in the database, until all of
# them together reach MEDIA_BUDGET_MB (then the oldest go). Bigger files
# (up to 10 GB) go on disk and are deleted after FILE_EXPIRY_HOURS.
KEEP_FILE_MB=25
MEDIA_BUDGET_MB=40000
FILE_EXPIRY_HOURS=720

# Optional: a Cloudflare Tunnel token, to reach the chat from anywhere
# without opening ports (see README.md, step 5).
TUNNEL_TOKEN=

# Optional, free: a Tailscale auth key for Tailscale Funnel (see README.md).
TS_AUTHKEY=
